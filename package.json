{
  "name": "icsjffl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "espn:audit-player-data": "node --env-file=.env.local --import tsx scripts/audit-espn-player-data.ts",
    "auth:bootstrap": "node --env-file=.env.local --import tsx scripts/bootstrap-commissioner.ts",
    "history:check": "node --conditions=react-server --env-file=.env.local --import tsx scripts/import-espn-history.ts --dry-run",
    "history:import": "node --conditions=react-server --env-file=.env.local --import tsx scripts/import-espn-history.ts",
    "drafts:import": "node --conditions=react-server --env-file=.env.local --import tsx scripts/import-espn-drafts.ts",
    "players:current:import": "node --conditions=react-server --env-file=.env.local --import tsx scripts/import-current-players.ts",
    "players:historical:import": "node --conditions=react-server --env-file=.env.local --import tsx scripts/import-historical-players.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
