# Public leagues need only the league ID. Blank ID enables labeled mock data.
ESPN_LEAGUE_ID=
# Private leagues need both cookie values. Server-only; never use NEXT_PUBLIC_.
ESPN_S2=
ESPN_SWID=

# Public browser/server reads. Safe to expose; database writes require the
# separate server-only secret key below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical production origin used for email-confirmation redirects.
NEXT_PUBLIC_SITE_URL=

# Used only by the one-off ESPN history import. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Used only by the one-time commissioner bootstrap command.
COMMISSIONER_EMAIL=
